# ==========================================
# Application & Domain Configuration
# ==========================================
NODE_ENV=development
APP_DOMAIN=localhost:3000

# ==========================================
# Database Connection (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/online_editing?schema=public"

# ==========================================
# Authentication & Session Security
# Generate a secure 32+ character key with: openssl rand -base64 32
# ==========================================
SESSION_SECRET="change_me_to_a_secure_random_32_character_secret_key"

# ==========================================
# AI Provider Configuration ('mock' for zero-cost dev/tests)
# Options: 'mock', 'remove.bg', 'fal.ai'
# ==========================================
AI_PHOTO_PROVIDER="mock"
REMOVE_BG_API_KEY=""
FAL_KEY=""

# ==========================================
# AI Audio Provider Configuration ('mock' for zero-cost dev/tests)
# Options: 'mock', 'elevenlabs'
# ==========================================
AI_AUDIO_PROVIDER="mock"
ELEVENLABS_API_KEY=""

# ==========================================
# Cloudflare R2 Object Storage (S3-Compatible)
# ==========================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="online-editing-media"
R2_PUBLIC_DOMAIN="https://media.yourdomain.com"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"

# ==========================================
# Paddle Payment Gateway (Merchant of Record)
# ==========================================
PADDLE_API_KEY="pdl_test_apikey"
PADDLE_WEBHOOK_SECRET="pdl_ntfset_webhooksecret"

